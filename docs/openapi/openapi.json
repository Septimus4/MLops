{
  "openapi": "3.1.0",
  "info": {
    "title": "Home Credit Scoring API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Return service readiness information.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "description": "Score a single applicant.",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InputPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "description": "Return aggregated operational metrics for the scoring service.",
        "operationId": "metrics_metrics_get",
        "parameters": [
          {
            "name": "window_minutes",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Window Minutes"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "message"
        ],
        "title": "ErrorResponse",
        "description": "Standard error envelope."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "model_path": {
            "type": "string",
            "title": "Model Path"
          },
          "feature_count": {
            "type": "integer",
            "title": "Feature Count"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model_name",
          "model_version",
          "model_path",
          "feature_count",
          "threshold",
          "environment"
        ],
        "title": "HealthResponse",
        "description": "Payload returned by the health endpoint."
      },
      "InputPayload": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Idempotency token"
          },
          "applicant_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applicant Id",
            "description": "Domain identifier of the applicant"
          },
          "features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Features",
            "description": "Key/value feature dictionary aligned with training schema"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "features"
        ],
        "title": "InputPayload",
        "description": "Inbound payload for scoring requests."
      },
      "MetricsResponse": {
        "properties": {
          "window_minutes": {
            "type": "integer",
            "title": "Window Minutes"
          },
          "request_count": {
            "type": "integer",
            "title": "Request Count"
          },
          "error_count": {
            "type": "integer",
            "title": "Error Count"
          },
          "avg_latency_ms": {
            "type": "number",
            "title": "Avg Latency Ms"
          },
          "p95_latency_ms": {
            "type": "number",
            "title": "P95 Latency Ms"
          },
          "mean_score": {
            "type": "number",
            "title": "Mean Score"
          },
          "drift_alerts": {
            "type": "integer",
            "title": "Drift Alerts"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "window_minutes",
          "request_count",
          "error_count",
          "avg_latency_ms",
          "p95_latency_ms",
          "mean_score",
          "drift_alerts"
        ],
        "title": "MetricsResponse",
        "description": "Aggregated operational metrics."
      },
      "PredictionResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Idempotency token echo"
          },
          "applicant_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applicant Id"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "binary_decision": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Binary Decision"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold"
          },
          "inference_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Inference Ms"
          },
          "processed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Processed At"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "model_name",
          "model_version",
          "score",
          "binary_decision",
          "threshold",
          "inference_ms"
        ],
        "title": "PredictionResponse",
        "description": "API response returned after scoring."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}